
// LeetCode 344: Reverse String
// Approach: Two Pointers
// Use start and end pointers at both ends of the array.
// Swap characters and move pointers towards the center.
// TC: O(n)
// SC: O(1)

class Solution {
    public void reverseString(char[] s) {
        int start = 0;
        int end = s.length - 1;

        while (start < end) {
            char temp = s[start];
            s[start] = s[end];
            s[end] = temp;

            start++;
            end--;
        }
    }
}
