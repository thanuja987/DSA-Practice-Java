// LeetCode 58: Length of Last Word
// Approach: Traverse from Right to Left
// Ignore trailing spaces and count characters of the last word.
// Stop when a space is found after counting characters.
// TC: O(n)
// SC: O(1)

class Solution {
    public int lengthOfLastWord(String s) {
        int count=0;
        for(int i=s.length()-1;i>=0;i--){
            if(s.charAt(i)==' '){
                if(count>0){
                    break;
                }
                }else{
                    count++;
                }
            
        }
        return count;
    }
}
